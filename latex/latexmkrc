# latexmkrc — Custom dependency rules for BCP Education books
# This file is included by Makefile.common via the -r flag.
# It teaches latexmk how to run makeglossaries and biber automatically.

# ── Bibliography (biblatex + biber) ───────────────────────────────────────────
# $bibtex_use = 2: run biber/bibtex even when .bbl is newer than .aux.
# Without this explicit setting, latexmk may fall back to plain bibtex when
# the .bcf file is not found at startup (e.g. fresh build with out/ empty).
$bibtex_use = 2;

# macOS TeX Live ships biber as a universal (x86_64+arm64) binary that
# self-extracts its native slice at runtime via `lipo ... -extract_family`.
# Recent Xcode Command Line Tools removed -extract_family from lipo, so the
# stock biber fails immediately with "extracting arm64 binary with lipo
# failed". Prefer a native (non-universal) Homebrew build when present.
if (-x '/opt/homebrew/bin/biber') {
    $biber = '/opt/homebrew/bin/biber';
}

# ── Glossaries (glossaries-extra) ─────────────────────────────────────────────
# .glo → .gls  (main glossary)
# .acn → .acr  (acronym list)
# Builds run in the book's own directory (no -output-directory), so $_[0] is
# normally just the jobname, but keep the path-splitting logic in case a
# directory-qualified name is ever passed.
add_cus_dep('glo', 'gls', 0, 'run_makeglossaries');
add_cus_dep('acn', 'acr', 0, 'run_makeglossaries');

sub run_makeglossaries {
    my ($base_name, $path);
    my $arg = $_[0];
    if ( $arg =~ /^(.*\/)([^\/]*)$/ ) {
        ($path, $base_name) = ($1, $2);
    } else {
        ($path, $base_name) = ('', $arg);
    }
    my $cmd = $silent
        ? "makeglossaries -q"
        : "makeglossaries";
    if ($path) {
        return system("$cmd -d '$path' '$base_name'");
    } else {
        return system("$cmd '$base_name'");
    }
}

